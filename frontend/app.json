{
  "expo": {
    "name": "AUREA",
    "slug": "AUREA",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/aurea-app-icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/aurea-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.tup_jssrosario.AUREA"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/aurea-favicon.png"
    },
    "plugins": [
      "./plugins/withExpoGlKeepRules",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/aurea-pateros-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-audio",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow AUREA to photograph your senior citizen ID.",
          "photosPermission": "Allow AUREA to select your senior citizen ID photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b3013be5-e3fe-4959-acaf-fe18c61bec6c"
      }
    }
  }
}
