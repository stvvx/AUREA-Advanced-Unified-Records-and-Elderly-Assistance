
# ─── AUREA Frontend Environment Variables ────────────────────────────────────
#
# ANDROID DEVICE TESTING NOTE:
# ─────────────────────────────
# "localhost" resolves to the PHONE itself, NOT your development PC.
#
#  ✅ Android Emulator  → use: http://10.0.2.2:5000     (handled automatically in loloApi.ts)
#  ✅ Physical Device   → replace with your PC's LAN IP:
#                         e.g.  http://192.168.1.12:5000   ← your current PC LAN IP
#                         Find it again with: ipconfig (Windows) → look for "IPv4 Address"
#  ✅ Production        → replace with your deployed backend URL
#
# The loloApi.ts service reads this value and automatically replaces
# "localhost" with the correct Android IP if a LAN IP is detected from Expo.

EXPO_PUBLIC_API_URL=http://localhost:5000
